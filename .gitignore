# Dependencies
node_modules/

# Build outputs
dist/
dist-backend/
dist-frontend/
build/
*.tsbuildinfo

# M14 release resources（含随包 node 二进制与原生模块，由 release.mjs 生成）。
# 仅忽略 per-arch 目录；resources/icon.icns、icon.png、scripts/make-icon.py 需入库。
resources/*/

# Frontend
.vite/
coverage/

# Env & local
.env
.env.local
.env.*.local
.env.*
!.env.example

# Secrets / signing material
*.pem
*.key
*.p12
*.p8
*.mobileprovision

# Local test data & user content（书籍/数据库/笔记绝不入库）
*.pdf
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
test-data/
fixtures/
samples/

# Local Claude Code settings（plans 可入库，个人设置不入库）
.claude/settings.local.json

# macOS
.DS_Store

# Logs
*.log
npm-debug.log*

# Editor
.vscode/
.idea/
*.swp

# Electron build artifacts (dmg/zip)
release/
*.dmg
*.blockmap
