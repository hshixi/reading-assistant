# 复制为 backend/.env 使用（config.ts 启动时自动加载）。
# 注意：AI 配置优先读 app_settings 表（设置页 M12 写入），此处仅为默认值/兜底。

# ---- 服务 ----
HOST=127.0.0.1
PORT=8787
NODE_ENV=development

# ---- 数据库（DATABASE_DRIVER=mysql | sqlite | auto，auto 连不上 MySQL 时自动退回 sqlite） ----
DATABASE_DRIVER=sqlite
# 数据根目录（sqlite 文件/books/media 都在其下）；默认 ~/.reading-assistant
# DATA_DIR=/Users/you/.reading-assistant
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=reading_assistant

# ---- AI（DeepSeek，OpenAI 兼容） ----
# 真实 API key：请填入 app_settings（设置页），或暂时用这里兜底。
# 安全要求：key 只允许出现在后端，严禁写入日志，渲染层永远拿不到。
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash-vision-exp
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.3
# AI_API_KEY=sk-xxx

# ---- 开发/测试 ----
# AI_MOCK=1 时聊天退回 M8 的本地 mock 打字机（离线开发用，不调真实 API）
# AI_MOCK=1
