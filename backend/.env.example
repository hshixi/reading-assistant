# ===== 服务 =====
PORT=8787
HOST=127.0.0.1
NODE_ENV=development

# ===== 数据库（开发默认 SQLite，无需安装 MySQL） =====
# mysql | sqlite | auto（auto：探测 MySQL 失败自动退回 SQLite）
DATABASE_DRIVER=sqlite
# 数据目录（sqlite 模式数据库文件所在目录；默认取系统 userData，开发可显式指定）
DATA_DIR=./data

# ---- 仅 DATABASE_DRIVER=mysql / auto 时使用 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=reading_assistant

# ===== DeepSeek AI（可在设置页覆盖，存 app_settings） =====
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-v4-flash-vision-exp
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.3
