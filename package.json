{
  "name": "reading-assistant",
  "version": "0.2.2",
  "private": true,
  "description": "macOS 辅助阅读桌面应用：本地 PDF 阅读 + AI 助手（DeepSeek vision）",
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "electron"
  ],
  "scripts": {
    "build": "npm run build:shared && npm run build:backend && npm run build:frontend && npm run build:electron",
    "build:shared": "npm run build -w @reading/shared",
    "build:backend": "npm run build -w @reading/backend",
    "build:backend-bundle": "node scripts/build-backend.mjs",
    "build:frontend": "npm run build -w @reading/frontend",
    "build:electron": "npm run build -w @reading/electron",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "dev": "node scripts/dev.mjs",
    "dev:prod": "node scripts/dev-prod.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "typescript-eslint": "^8.19.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  }
}
